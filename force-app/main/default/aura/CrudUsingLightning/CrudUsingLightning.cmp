<aura:component controller="CrudUsingLightning" implements="force:appHostable,forceCommunity:availableForAllPageTypes,flexipage:availableForAllPageTypes" access="global">
    <aura:attribute name="childAttribute" type="String"/>
    <aura:attribute name="AccData" type="Account" default="{ 'sobjectType': 'Account'}"/>
    <aura:attribute name="acc" type="Account[]" default="{ 'sobjectType': 'Account'}"/>
    <aura:attribute name="updatedata" type="Account" default="{ 'sobjectType': 'Account'}"/>
    <aura:attribute name="selectedCount" type="Integer" default="0"/>
    <aura:attribute name="insertacc" type="Boolean" default="true"/>
    <aura:attribute name="displayacc" type="Boolean" default="false"/>
    <aura:attribute name="recordform" type="Boolean" default="false"/>
    <aura:attribute name="showacc" type="Boolean" default="false"/>
    <aura:if isTrue="{!v.insertacc}">
        <lightning:card iconName="standard:user" title="Account Details">
            <div class="slds-p-horizontal_small slds-form slds-form_horizontal">
                <div class="slds-col">
                    <lightning:input type="text" name="input1" label="Account Name" value="{!v.AccData.Name}" required="true"/>
                </div> 
                 <div class="slds-col">
                    <lightning:input type="email" name="input1" label="Account Name" value="{!v.AccData.Email__c}" required="true"/>
                </div> 
                <div class="slds-col">
                    <lightning:input type="phone" name="input1" label="Phone" value="{!v.AccData.Phone}" required="true"/>
                </div> 
                <!--  <aura:iteration items="Contactobj" var="cont">
                <div class="slds-col">
                    <lightning:input type="text" name="input1" label="Address" value="{!v.AccData.Site}" required="true"/>
                </div>  
                
                <div class="slds-col">
                    <lightning:input type="Email" name="input1" label="Email" value="{!v.conData.Email}" required="true"/>
                </div>
                 <ui:outputText class="slds-output" value="{!v.childAttribute}"></ui:outputText>
                </aura:iteration>-->
            </div>
            <aura:set attribute="footer">
                <div class="slds-text-align_center">
                    <lightning:button variant="brand" iconName="utility:save" label="SAVE"  onclick="{!c.save}"/>
                </div><br></br>
                <div class="slds-text-align_center">
                    <lightning:button variant="brand"  label="Display Data"  onclick="{!c.display}"/>
                </div>
            </aura:set>
        </lightning:card>
    </aura:if>
    <!--<aura:if isTrue="{!v.displayacc}">
        <div class="slds-text-align_center">
                    <lightning:button variant="brand"  label="Display"  onclick="{!c.display}"/>
                </div><br></br>
    </aura:if>-->
    <aura:if isTrue="{!v.showacc}">
        <div class="slds-page-header">
            <p class="slds-page-header__title slds-truncate" title="">Account List With Checkbox Action</p>
            <span class="slds-badge">Selected Account:{!v.selectedCount}</span>
            <div class="slds-grid slds-grid--align-end"> 
                 <button class="slds-button slds-button--brand" onclick="{!c.doEdit}">Edit</button>
                <button class="slds-button slds-button--brand" onclick="{!c.deleteSelected}">Delete</button>
            </div>
        </div>
        <table class="slds-table slds-table_cell-buffer slds-table_bordered">
            <thead>
                <tr class="slds-line-height_reset">
                    <label class="slds-checkbox">
                        <!--header checkbox for select all-->
                        <ui:inputCheckbox aura:id="box3" change="{!c.selectAll}"/>
                        <span class="slds-checkbox--faux"></span>
                        <span class="slds-form-element__label text"></span>
                    </label>
                    <th class="" scope="col">
                        <div class="slds-truncate" title="Name">Account Name</div>
                    </th>
                    <th class="" scope="col">
                        <div class="slds-truncate"  title="Type">Phone</div>
                    </th>
                    <!-- <th class="" scope="col">
                        <div class="slds-truncate"  title="Type">Address</div>
                    </th>
                    <th class="" scope="col">
                        <div class="slds-truncate" title="Phone">Contact Name</div>
                    </th>-->
                </tr>
            </thead>
            <tbody>
                <aura:iteration items="{!v.acc}" var="acc" >
                    <tr>
                       <aura:if isTrue = "{!v.Segment == col.segment}">
                    <tr class="{! (index%2)==0?'':'altRow'}">
                        <th scope="row" width = "10%">
                            <div class="slds-truncate">
                                    <lightning:input type="checkbox" aura:id="checkboxField" onchange = "{!c.OnRemove}"/>
                            </div>
                        </th>
                    </tr>
                </aura:if>
                        <td data-label="Account Name">
                            <div class="slds-truncate" title="">{!acc.Name}</div>
                        </td>
                        <td data-label="Close Date">
                            <div class="slds-truncate" title="">{!acc.Phone}</div>
                        </td>
                        <!--<td data-label="Close Date">
                            <div class="slds-truncate" title="">{!acc.Site}</div>
                        </td>-->
                        <td>
                            <lightning:buttonMenu title="Show 2 more actions" iconName="utility:down" class="downbtnwiddate"
                                                  iconSize="x-small" alternativeText="Settings" 
                                                  onselect="{! c.handleMenuSelect }" > 
                                <lightning:menuItem class="moreoptionmenu" label="Edit" value="{!acc.Id+'_EDIT'}" 
                                                    accesskey='1'/>
                                <lightning:menuItem class="moreoptionmenu" label="Delete" value="{!acc.Id+'_DELETE'}" 
                                                    accesskey='2'/>
                                
                            </lightning:buttonMenu>
                        </td>
                    </tr>
                </aura:iteration>
            </tbody>
        </table>
    </aura:if>
    <aura:if isTrue="{!v.recordform}">
        <lightning:card iconName="standard:user" title="Account Details">
            <div class="slds-box slds-box-auto">
                <div class="slds-form-element__control slds-m-around_small">
                    <lightning:input type="text" name="input1" label="Account Name" value="{!v.updatedata.Name}" required="true"/>
                </div>
                <div class="slds-form-element__control slds-m-around_small">
                    <lightning:input aura:id="Task1" type="text" name="red" label="phone" value="{!v.updatedata.Phone}"  required="true" />
                </div>
                <div class="slds-form-element__control slds-m-around_small slds-text-align_right">
                    <lightning:button variant="brand" label="Update" title="Update" onclick="{!c.updaterecord}" />
                    <lightning:button variant="brand" label="cancel" title="Cancel" onclick="{!c.handelcancel}" />
                    
                </div>
            </div>
        </lightning:card>
    </aura:if>
</aura:component>