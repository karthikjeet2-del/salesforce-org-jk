<aura:component controller="Communitypage" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    <aura:attribute name="userlogin" type="Boolean" default="false"/>
    <aura:attribute name="emplogin" type="Boolean" default="false"/>
    <aura:attribute name="userdata" type="string[]" default=""/>
    <aura:attribute name="empdata" type="string[]" default=""/>
    <lightning:card >
        <div class="slds-p-horizontal_small slds-form slds-form_horizontal">
            <div class="slds-text-align_center">
                <lightning:button variant="brand"  label="Login using Username"  onclick="{!c.username}"/>
            </div><br></br>
            <div class="slds-text-align_center">
                <lightning:button variant="brand"  label="Login using Employee ID"  onclick="{!c.empid}"/>
            </div>
        </div>
  
    <aura:if isTrue="{!v.userlogin}">
      <lightning:card >
            <div class="slds-p-horizontal_small slds-form slds-form_horizontal">
                <div class="slds-col">
                    <lightning:input type="Email" name="input1" label="User Name" value="{!v.userdata[0]}" required="true"/>
                </div> 
               <div class="slds-col">
                   <lightning:input  label="Password" type="{!v.showpassword ? 'text':'password'}" 
                             aura:id="password_field" value="{!v.userdata[1]}" required="true"/>
                     <!-- <lightning:input type="text"  label="Password" name="input1" value="" required="true"/>--> 
                </div> 
             </div>
            <aura:set attribute="footer">
                <div class="slds-text-align_center">
                    <lightning:button variant="brand"  label="LOGIN"  onclick="{!c.saveUser}"/>
                </div><br></br>
            </aura:set>
        </lightning:card>
    </aura:if>
     <aura:if isTrue="{!v.emplogin}">
        <lightning:card >
            <div class="slds-p-horizontal_small slds-form slds-form_horizontal">
                <div class="slds-col">
                    <lightning:input type="text" name="input1" label="Emp Id" value="{!v.empdata[0]}" required="true"/>
                </div> 
                <div class="slds-col">
                    <lightning:input type="text" name="input1" label="Token" value="{!v.empdata[1]}" required="true"/>
                </div> 
             </div>
            <aura:set attribute="footer">
                <div class="slds-text-align_center">
                    <lightning:button variant="brand" label="LOGIN"  onclick="{!c.saveEmpid}"/>
                </div>
            </aura:set>
          </lightning:card>
    </aura:if>
   </lightning:card>
</aura:component>