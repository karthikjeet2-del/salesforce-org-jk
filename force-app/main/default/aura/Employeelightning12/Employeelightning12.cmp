<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" controller="Employeelightning12" >
	<aura:attribute name="employeeObj" type="EmplyeeNew__c" default="{ 'sobjectType': 'EmplyeeNew__c'}"/>
    
    <div class="slds-grid">
        <div class="modal-header slds-modal__header slds-size_1-of-1">
        <h4 class="title slds-text-heading--medium">Employee Lightning Page</h4>
     
       <!--   <lightning:card title="New employee" footer="Click on Save button to create new employee.">
           Save button -->
            <aura:set attribute="actions">
                <lightning:button aura:id="saveId"
                                  label="Save"   
                                  onclick="{!c.dosave}"/>
            </aura:set>
            
            <!--/ Save button -->
            
            <!-- Body -->
            <p class="slds-p-horizontal_small">
                <lightning:input aura:id="empid"
                                 label="Emp Id"
                                 type="autonumber"
                                 
                                 value="{!v.employeeObj.Name}"/>
                <lightning:input aura:id="Emp Name"
                                 label="Name"
                                 type="String"
                                 value="{!v.employeeObj.Emp_name__c}"/>
                <lightning:input aura:id="Phone"
                                 label="Phone No"
                                 type="Phone"
                                 value="{!v.employeeObj.Phone__c}"/>
            </p>
            <!--/ Body -->
            
       
            
    </div>	     </div>
</aura:component>