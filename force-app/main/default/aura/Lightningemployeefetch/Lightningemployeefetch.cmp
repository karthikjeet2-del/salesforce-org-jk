<aura:component controller="lightningemployee"  implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
   <aura:attribute name="EmpIDhere" type="String" default="" access="global"/>
   <aura:attribute name="EmpData" type="EmplyeeNew__c" default="{ 'sobjectType':'EmplyeeNew__c' }"/>
   <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
  <!-- <aura:registerEvent name="oSelectedRecordEvent" type="c:selectedsObjectRecordEvent"/>-->
   
 <table class="slds-table slds-table_cell-buffer slds-table_bordered">
    <!-- <thead>
    <tr class="slds-line-height_reset">
