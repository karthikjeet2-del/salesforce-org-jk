        <thead>
            <tr>
                <th scope="col"><span class="slds-truncate">Emp ID</span></th>
                <th scope="col"><span class="slds-truncate"> Name</span></th>
                <th scope="col"><span class="slds-truncate"> phone</span></th>
            </tr>
        </thead>
        <tbody>
            <aura:iteration items="{!v.EmpData}" var="e">
                <tr>
                    <td>{!e.Name}</td>
                    <td>{!e.Emp_name__c}</td>
                     <td>{!e.Phone__c}</td>
                </tr>
            </aura:iteration>
        </tbody> </table>
    
</aura:component>