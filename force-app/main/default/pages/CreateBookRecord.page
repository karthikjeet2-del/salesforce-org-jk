<apex:page standardController="Book__c" extensions="bookHandler">
    <apex:form >
        <apex:pageBlock title="Book" mode="save">
            <apex:pageBlockSection title="Create Book Record" columns="1">
                <apex:inputField value="{!bookRec.Name}"/>
                <apex:inputField value="{!bookRec.Book_Genre__c}"/>
            </apex:pageBlockSection>
            <apex:pageBlockButtons >
                <apex:commandButton value="Save" action="{!saveRecord}" id="saveButton"/>
                <apex:commandButton value="Cancel" action="{!cancel}" id="cancelButton" />
            </apex:pageBlockButtons>
        </apex:pageBlock>
    </apex:form>
</apex:page>